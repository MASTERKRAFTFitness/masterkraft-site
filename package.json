{
  "name": "masterkraft-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/check-snapshot.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "predeploy": "npm run check:snapshot && npm test && npm run check:obsolete && npm run check:catalogue",
    "deploy": "npx --yes vercel@latest deploy --prod --yes",
    "build:catalogue": "node scripts/build-catalogue.mjs",
    "check:catalogue": "node scripts/build-catalogue.mjs --check",
    "check:snapshot": "node scripts/check-snapshot.mjs",
    "verify:catalogue": "PARITY=1 vitest run src/lib/catalogue-parity.test.ts",
    "build:obsolete": "node scripts/build-obsolete-skus.mjs",
    "check:obsolete": "node scripts/check-obsolete.mjs",
    "mirror:images": "node scripts/mirror-product-images.mjs",
    "compress:assets": "python3 scripts/compress-assets.py",
    "report:specs": "vitest run --config vitest.reports.config.mts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

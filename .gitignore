# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Throwaway artifacts, regenerable
lh-desktop.json
reports/*.xlsx
.claude/

# Throwaway artifacts, regenerable
lh-desktop.json
reports/*.xlsx
.claude/

# Credentials kept locally, never committed
Stripe Keys.rtf
*.rtf

# supabase CLI scratch
supabase/.temp

# Brand image exports from scripts/export-brand-images.py. Hundreds of MB of
# PNGs, regenerated on demand, and NOT part of the site: `vercel deploy --prod`
# uploads the working tree, so an untracked export directory would be shipped to
# production and would also trip the dirty-tree guard in check-deploy-branch.
reports/*-images/
